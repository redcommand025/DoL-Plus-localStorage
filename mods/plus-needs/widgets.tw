:: Widgets Plus Needs [widget plusneeds]
/* Sidebar captions for the Plus Needs mod. Values: 2000 = satisfied, 0 = empty. */
<<widget "plusneedsbar">>
	/* _args[0] = label, _args[1] = value, _args[2..5] = flavor text full/mid/low/very low */
	<<set _pnValue to Math.clamp(_args[1], 0, 2000)>>
	<div @class="'plusneedscaption' + ($options.showCaptionText is true ? '' : ' rightMeterText')" @title="_args[0] + ': ' + _pnValue.toFixed(0) + ' / 2000'">
		<div @class="($options.showCaptionText is true ? '' : 'rightMeterText')">
			_args[0]:
			<<if $options.showCaptionText is true>>
				<<if _pnValue gte 1500>>
					<span class="green">_args[2]</span>
				<<elseif _pnValue gte 1000>>
					<span class="lblue">_args[3]</span>
				<<elseif _pnValue gte 400>>
					<span class="purple">_args[4]</span>
				<<else>>
					<span class="red">_args[5]</span>
				<</if>>
			<</if>>
		</div>
		<<set _showCaptionText to !$options.showCaptionText>>
		<<statbarinverted _pnValue 2000 _showCaptionText>>
	</div>
<</widget>>

<<widget "plusneedscaption">>
	<<run plusNeedsInit()>>
	<<plusneedsbar "Hunger" $plusHunger "You feel well fed." "You could go for a snack." "You should eat something." "You're starving.">>
	<<plusneedsbar "Thirst" $plusThirst "You're not thirsty." "You could use a drink." "You should drink something." "You're parched.">>
	<<plusneedsbar "Bladder" $plusBladder "You feel comfortable." "You'll need the toilet at some point." "You should find a toilet soon." "You really need a toilet now!">>
	<<plusneedsbar "Bowels" $plusBowels "You feel comfortable." "You'll need the toilet at some point." "You should find a toilet soon." "You really need a toilet now!">>
	<<if $plusHunger lte 0 or $plusThirst lte 0>>
		<span class="red">You feel weak.</span>
	<</if>>
	<<if $plusHunger lte 0>>
		<span class="red">Your stomach aches with hunger.</span>
	<</if>>
	<<if $plusThirst lte 0>>
		<span class="red">Your head pounds from thirst.</span>
	<</if>>
<</widget>>

/* Link shown in bathrooms and toilets. */
<<widget "plusToiletLink">>
	<<bathroomicon "sink">><<link [[Use the toilet (0:03)|Plus Needs Toilet]]>><<set $plusToiletReturn to $passage>><</link>>
	<br>
	<<plusCleanLink>>
<</widget>>

/* Public toilet block (beach, High Street): uses the same toilet passage, so stats are counted the same way. */
<<widget "plusPublicToiletLink">>
	<<bathroomicon "sink">><<link `_args[0] + " (0:03)"` "Plus Needs Toilet">><<set $plusToiletReturn to $passage>><</link>>
	<br>
<</widget>>

<<widget "plusKitchenSnack">>
	<<foodicon "creambun">><<link [[Have a quick snack and a glass of water (0:10)|Plus Needs Kitchen Snack]]>><<pass 10>><<set $plusToiletReturn to $passage>><</link>>
	<br>
<</widget>>

<<widget "plusNeedsAccident">>
	<<set _pnWhich to _args[0]>>
	<<set _pnFloor to plusAccidentFloor()>>
	<<set _pnGround to ($outside ? "ground" : "floor")>>
	<span class="pink">
	<<if _pnFloor>>
		You couldn't hold it any longer and didn't make it to a toilet in time. With nothing on to catch it,
		<<if _pnWhich is "plusBladder">>a puddle spreads across the _pnGround at your feet.
		<<elseif _pnWhich is "plusBowels">>you leave a mess on the _pnGround beneath you.
		<<else>>you leave a puddle and a mess on the _pnGround beneath you.
		<</if>>
	<<elseif _pnWhich is "plusBladder">>
		You couldn't hold it any longer and didn't make it to a toilet in time. You have wet yourself.
	<<elseif _pnWhich is "plusBowels">>
		You couldn't hold it any longer and didn't make it to a toilet in time. You have soiled yourself.
	<<else>>
		You couldn't hold it any longer and didn't make it to a toilet in time. You have had an accident at both ends.
	<</if>>
	</span>
	<<set _pnULwet to false>><<set _pnLwet to false>>
	<<if !_pnFloor>>
		/* Wet the clothing via the base game's own wetness ($underlowerwet / $lowerwet, 0-200; <<effects>> updates the stages and drying). */
		<<if _pnWhich is "plusBladder">><<set _pnUL to 180>><<set _pnL to 40>><<elseif _pnWhich is "plusBowels">><<set _pnUL to 160>><<set _pnL to 30>><<else>><<set _pnUL to 200>><<set _pnL to 50>><</if>>
		<<set _pnULwet to !$worn.under_lower.type.includes("naked") and !waterproofCheck($worn.under_lower)>>
		<<set _pnLwet to !$worn.lower.type.includes("naked") and !waterproofCheck($worn.lower)>>
		/* Accident wetness on under_lower is capped at 95 so it stays below the "soaked through" (100) stage. */
		<<if _pnULwet>><<set _pnUL to Math.max(0, Math.min(_pnUL, 95 - $underlowerwet))>><<underlowerwet _pnUL>><</if>>
		<<if _pnLwet>><<lowerwet _pnL>><</if>>
		<<run plusClothesAccident(_pnWhich)>>
		<<if _pnULwet>>Your $worn.under_lower.name <<underlowerplural>> soaked<<if _pnLwet>>, and a damp patch is spreading on your $worn.lower.name<</if>>.
		<<elseif _pnLwet>>A damp patch spreads on your $worn.lower.name.
		<</if>>
	<</if>>
	Your face burns with embarrassment<<if _pnULwet or _pnLwet>>, and your clothes will need a good wash<<elseif _pnFloor>>, and you hurry away from the _pnGround before anyone can connect it to you<</if>>.
	<<stress 12>><<gstress>><<set $hygiene to Math.clamp($hygiene + 400, 0, 2000)>>
	<<set _pnSeen to plusAccidentSpotRoll(_pnFloor)>>
	<<if _pnSeen gt 0>>
		<br><span class="red">
		<<if _pnSeen is 2>>
			<<if _pnFloor>>A group of students sees everything. Laughter and shrieks of disgust ring out, and by the end of the day it seems the whole school knows.<<else>>Some students notice straight away. Whispers and sniggers follow you down the corridor, and you know the story will spread.<</if>>
		<<elseif _pnFloor>>
			<<print either("Someone nearby sees the whole thing. They stare at the _pnGround, then at you, with open disgust.", "A passer-by stops dead and gapes at the _pnGround, then at you. Others turn to look.", "You hear a gasp behind you. Someone saw everything, and they're already pointing it out to others.")>>
		<<else>>
			<<print either("Someone nearby notices what happened. They wrinkle their nose and look away.", "A passer-by glances at your clothes and their expression turns to pity and disgust.", "You catch someone staring at you, then whispering to their friend.")>>
		<</if>>
		</span>
		<<if _pnFloor>><<stress 15>><<else>><<stress 10>><</if>><<gstress>>
		<<if _pnSeen is 2>><<status -5>><<lcool>><</if>>
	<</if>>
	<br>You feel less in control of yourself.
	<<if _pnWhich is "plusBladder">><<control -10>><<lcontrol>><<elseif _pnWhich is "plusBowels">><<control -25>><<llcontrol>><<else>><<control -40>><<lllcontrol>><</if>>
<</widget>>

:: Plus Needs Toilet [plusneeds]
<<effects>><<pass 3>>
<<if $plusBladder lt 1900 or $plusBowels lt 1900>>
	You find a free stall and use the toilet, then wash your hands at the sink. You feel much more comfortable.
<<else>>
	You use the toilet, then wash your hands at the sink. You didn't really need to go.
<</if>>
<<run plusNeedsToilet("both")>>
<br><br>
<<bathroomicon "sink">><<link [[Drink some water from the tap (0:01)|Plus Needs Toilet Drink]]>><<pass 1>><<run plusNeedsConsume(0, 400, "drink", 250)>><</link>>
<br>
<<getouticon>><<link [[Finish|$plusToiletReturn]]>><<set $eventskip to 1>><</link>>

:: Plus Needs Toilet Drink [plusneeds]
<<effects>>
You cup your hands under the tap and drink some cold water.
<br><br>
<<getouticon>><<link [[Finish|$plusToiletReturn]]>><<set $eventskip to 1>><</link>>

:: Plus Needs Kitchen Snack [plusneeds]
<<effects>>
You grab a quick snack and a glass of water.
<<run plusNeedsConsume(900, 400, "snack", 250)>>
<br><br>
<<getouticon>><<link [[Finish|$plusToiletReturn]]>><<set $eventskip to 1>><</link>>

:: Widgets Plus Needs Mobile [widget plusneeds]
<<widget "plusNeedsMobileStat">>
	/* _args: label, name, value. Full (2000) = green, empty = red. */
	<<mobileStatsColorSetIverted `Math.clamp(_args[2], 0, 2000)` 2000>>
	<div @class="'stat plus-needs-mini ' + _mobileColor">
		<mouse class="tooltip-centertop">_args[0]<span>_args[1]: <<print Math.round(_args[2])>> / 2000</span></mouse>
	</div>
<</widget>>

<<widget "plusNeedsMobile">>
	<<if Number.isFinite($plusHunger)>><<plusNeedsMobileStat "Hu" "Hunger" $plusHunger>><</if>>
	<<if Number.isFinite($plusThirst)>><<plusNeedsMobileStat "Th" "Thirst" $plusThirst>><</if>>
	<<if Number.isFinite($plusBladder)>><<plusNeedsMobileStat "Bl" "Bladder" $plusBladder>><</if>>
	<<if Number.isFinite($plusBowels)>><<plusNeedsMobileStat "Bw" "Bowels" $plusBowels>><</if>>
<</widget>>

:: Widgets Plus Needs Statistics [widget plusneeds]
<<widget "plusNeedsStatistics">>
	<<run plusNeedsInit()>><<set _pns to plusNeedsStats()>>
	<<foldout false "_plusNeedsFoldout">>
		<span class="gold">Needs</span>
		Total drunk: <<print (_pns.mlTotal / 1000).toFixed(2)>> litres (<<print _pns.mlTotal>> ml)
		<br>
		Drunk today: <<print _pns.mlToday>> ml
		<br>
		Drinks: _pns.drinks
		<br>
		Meals eaten: _pns.meals
		<br>
		Snacks eaten: _pns.snacks
		<br>
		Food eaten: about <<print _pns.kcal.toLocaleString()>> kcal
		<br>
		Toilet trips (bladder): _pns.pees
		<br>
		Toilet trips (bowels): _pns.poops
		<br>
		Times spotted relieving yourself outdoors: <<print _pns.spotted or 0>>
		<br>
		Accidents (wet/soiled/both at once): _pns.accWet/_pns.accSoiled/_pns.accBoth
		<br>
		Times you were starving (hunger hit 0): _pns.zeroHunger
		<br>
		Times you were parched (thirst hit 0): _pns.zeroThirst
		<br>
		Times people smelt your soiled clothes: _pns.smelt
		<br>
		Laundromat visits: _pns.laundromat
		<br>
		Accidents on the floor: _pns.accFloor
		<br>
		Times spotted having an accident: _pns.accSpotted
		<br>
		Times you found a place to go in public: _pns.findPlace (spotted _pns.findPlaceSpotted)
		<br><br>
	<</foldout>>
<</widget>>

:: Widgets Plus Needs Spots [widget plusneeds]
/* Public drinking spot. _args[0]: "fountain" | "stream" | "lake" | "cooler" | "cafe" | "shower" */
<<widget "plusDrinkLink">>
	<<set _pnSpot to _args[0]>>
	<<if _pnSpot is "stream">><<set _pnLabel to "Drink from the stream">><<elseif _pnSpot is "lake">><<set _pnLabel to "Drink some water from the lake">><<elseif _pnSpot is "cafe">><<set _pnLabel to "Ask for a glass of water">><<else>><<set _pnLabel to "Drink some water">><</if>>
	<<capture _pnSpot>><<bathroomicon "sink">><<link `_pnLabel + " (0:02)"` "Plus Needs Drink">><<set $plusDrinkSpot to _pnSpot>><<set $plusDrinkReturn to $passage>><</link>><</capture>>
	<br>
<</widget>>

/* Outdoor toilet. _args[0]: "forest" | "park" | "beach" | "lake" | "wolfcave" */
<<widget "plusOutdoorToiletLink">>
	<<if _args[0] is "beach">><<set _pnLabel to "Relieve yourself behind the dunes (0:03)">><<elseif _args[0] is "park">><<set _pnLabel to "Relieve yourself behind some bushes (0:03)">><<elseif _args[0] is "wolfcave">><<set _pnLabel to "Relieve yourself at the edge of the clearing (0:03)">><<else>><<set _pnLabel to "Relieve yourself behind a tree (0:03)">><</if>>
	<<set _pnOut to _args[0]>><<capture _pnOut>><<foresticon>><<link _pnLabel "Plus Needs Outdoor Toilet">><<set $plusOutdoorSpot to _pnOut>><<set $plusToiletReturn to $passage>><</link>><</capture>>
	<br>
<</widget>>

:: Plus Needs Drink [plusneeds]
<<effects>><<pass 2>>
<<set _pnSpot to $plusDrinkSpot>>
<<if _pnSpot is "stream">>
	You kneel by the stream, cup your hands in the cold, clear water and drink.
	<<run plusNeedsConsume(0, 450, "drink", plusNeedsML["stream"])>>
<<elseif _pnSpot is "lake">>
	You crouch at the water's edge and drink a few handfuls of cool lake water.
	<<run plusNeedsConsume(0, 450, "drink", plusNeedsML["lake"])>>
<<elseif _pnSpot is "cooler">>
	You fill a paper cup at the water cooler and drink it down.
	<<run plusNeedsConsume(0, 400, "drink", plusNeedsML["water cooler"])>>
<<elseif _pnSpot is "cafe">>
	You ask for a glass of tap water. It's brought over with a polite smile, and you drink it gratefully.
	<<run plusNeedsConsume(0, 450, "drink", plusNeedsML["cafe water"])>>
<<elseif _pnSpot is "shower">>
	You find the tap by the beach showers and drink some fresh water.
	<<run plusNeedsConsume(0, 400, "drink", plusNeedsML["fountain"])>>
<<else>>
	You lean over the drinking fountain and take a long drink of cool water.
	<<run plusNeedsConsume(0, 400, "drink", plusNeedsML["fountain"])>>
<</if>>
You feel refreshed.
<br><br>
<<getouticon>><<link [[Finish|$plusDrinkReturn]]>><<set $eventskip to 1>><</link>>

:: Plus Needs Outdoor Toilet [plusneeds]
<<effects>><<pass 3>>
<<set _pnChance to plusNeedsSpotChance($plusOutdoorSpot)>>
<<set _pnSpotted to random(1, 1000) lte _pnChance * 1000>>
<<if $plusOutdoorSpot is "beach">><<set _pnWhere to "behind a dune">><<elseif $plusOutdoorSpot is "park">><<set _pnWhere to "behind a clump of bushes">><<elseif $plusOutdoorSpot is "wolfcave">><<set _pnWhere to "at the edge of the clearing">><<else>><<set _pnWhere to "behind a thick tree">><</if>>
<<if _pnSpotted>>
	You find a spot _pnWhere and relieve yourself. Just as you finish, you hear footsteps. Someone walking by stops and stares at you, then quickly looks away.
	<br><br>
	<span class="red">Your cheeks burn with embarrassment.</span> You straighten your clothes and hurry off without looking back.
	<<stress 6>><<gstress>>
	<<run plusNeedsSpotted()>>
<<else>>
	You find a quiet spot _pnWhere and relieve yourself. Nobody seems to have noticed. You feel much more comfortable.
<</if>>
<<run plusNeedsToilet("both")>>
<br><br>
<<getouticon>><<link [[Continue|$plusToiletReturn]]>><<set $eventskip to 1>><</link>>

:: Widgets Plus Needs Notices [widget plusneeds]
<<widget "plusNeedsNeedNotice">>
	<<for _pnN range _plusNeedsNoticeList>>
		<<if _pnN.tier gte 3>><span class="red">_pnN.text</span>
		<<elseif _pnN.tier is 2>><span class="purple">_pnN.text</span>
		<<else>><span class="lblue">_pnN.text</span><</if>>
		<br>
	<</for>>
	<<if _plusNeedsNoticeStress>><<gstress>><</if>><<if _plusNeedsNoticePain>><<gpain>><</if>>
<</widget>>


:: Widgets Plus Needs Clothes [widget plusneeds]
/* "Try to remove dirt" link: wardrobes, changing rooms, bathrooms and toilets. Shows the worn items' state when not clean. */
<<widget "plusCleanLink">>
	<<if plusClothesWorn().some(i => i.plusDirt gte 1 or i.plusSoiled gt 0)>>
		<<bathroomicon "sink">><<link [[Try to scrub the dirt and stains out of your clothes (0:05)|Plus Needs Clean]]>><<if $passage isnot "Plus Needs Clean">><<set $plusCleanReturn to $passage>><</if>><</link>>
		<br>
	<</if>>
<</widget>>

<<widget "plusClothesLines">>
	<<set _pnLines to plusClothesItemLines().filter(l => !l.endsWith(" is clean.") and !l.endsWith(" are clean."))>>
	<<if _pnLines.length gt 0>><span class="plus-needs-clothes"><<for _pnLine range _pnLines>>_pnLine <</for>></span><br><br><</if>>
<</widget>>

<<widget "plusNeedsSmellNotice">>
	<<set _pnSmell to either(
		"Someone nearby wrinkles their nose and steps away from you. You realise they can smell your soiled clothes.",
		"A passer-by recoils with a look of disgust. The smell coming from your clothes is impossible to miss.",
		"You hear someone mutter about a horrible smell. Heads turn towards you, and you feel your cheeks burn.",
		"A couple of people glance at you and pull faces, covering their noses as they hurry past.",
		"Someone loudly asks what that stink is. You know exactly what it is, and so does everyone looking at you.")>>
	<span class="pink">_pnSmell</span> <<stress 6>><<gstress>>
<</widget>>

/* Laundromat link for High Street. */
<<widget "plusLaundromatLink">>
	<<if $exposed lte 0>>
		<<shopicon>><<link [[Laundromat (0:01)|Plus Needs Laundromat]]>><<pass 1>><</link>>
		<br>
	<</if>>
<</widget>>

:: Plus Needs Clean [plusneeds]
<<effects>><<pass 5>>
<<if plusClothesClean()>>
	You wet some paper towels and scrub at the worst marks on your clothes. It takes a few minutes, but they look and smell noticeably better.
<<else>>
	You scrub at your clothes for a few minutes, but the marks barely budge. You only manage to spread them around.
<</if>>
<br><br>
<<plusClothesLines>>
<<plusCleanLink>>
<<getouticon>><<link [[Finish|$plusCleanReturn]]>><<set $eventskip to 1>><</link>>

:: Plus Needs Laundromat [plusneeds]
<<effects>><<set $outside to 0>><<location "high">>
A small laundromat sits off High Street. Rows of washing machines and tumble dryers hum along one wall, and a sign by the counter reads: "Service wash £5. Spare robes available while you wait."
<br><br>
<<plusClothesLines>>
<<if $money gte plusLaundromatCost>>
	<<shopicon>><<link [[Have your clothes washed and dried (1:00, £5)|Plus Needs Laundromat Wash]]>><</link>>
<<else>>
	<span class="grey">Have your clothes washed and dried (1:00, £5) - you can't afford it.</span>
<</if>>
<br>
<<getouticon>><<link [[Leave (0:01)|High Street]]>><<pass 1>><</link>>
<br>

:: Plus Needs Laundromat Wash [plusneeds]
<<effects>>
<<if $money gte plusLaundromatCost>><<pass 60>><</if>>
<<if plusLaundromatWash()>>
	You hand over £5 and the attendant gives you a clean, thick spare robe to wear while you wait. You change in a small cubicle, sit on a plastic chair and flick through an old magazine while your clothes go round.
	<br><br>
	An hour later you change back into your clothes, warm from the dryer and completely clean.
<<else>>
	You can't afford the service wash.
<</if>>
<br><br>
<<getouticon>><<link [[Leave (0:01)|High Street]]>><<pass 1>><</link>>
<br>

:: Widgets Plus Needs Find Place [widget plusneeds]
<<widget "plusFindPlaceLink">>
	<<if plusFindPlaceAvailable()>>
		<<set _pnFK to plusFindPlaceKind()>>
		<<if _pnFK is "school">><<set _pnLabel to "Find somewhere out of sight to go (0:03)">><<elseif _pnFK is "busy">><<set _pnLabel to "Find a place to go (0:03)">><<else>><<set _pnLabel to "Find a quiet corner to go (0:03)">><</if>>
		<<foresticon>><<link _pnLabel "Plus Needs Find Place">><<set $plusToiletReturn to $passage>><</link>>
		<br>
	<</if>>
<</widget>>

:: Plus Needs Find Place [plusneeds]
<<effects>><<pass 3>>
<<set _pnFK to plusFindPlaceKind()>>
<<if _pnFK is "school">>
	<<set _pnWhere to either("You slip behind the bike sheds where you hope nobody will look", "You find a deserted corner behind the bins at the edge of the grounds", "You duck into the narrow gap behind the sports equipment store")>>
<<elseif _pnFK is "busy">>
	<<set _pnWhere to either("You duck into a narrow alley between two shops", "You squeeze behind a large dumpster at the back of a shop", "You slip into a recessed doorway, out of the flow of people")>>
<<else>>
	<<set _pnWhere to either("You find a shadowy corner where the street goes quiet", "You crouch behind a stack of crates in a quiet back lane", "You step into an overgrown gap between two buildings")>>
<</if>>
<<if plusFindPlaceRoll()>>
	_pnWhere and relieve yourself as quickly as you can. Just as you finish, you realise you're not alone.
	<<if _pnFK is "school">>A couple of students have seen you. They burst out laughing and hurry off, clearly eager to tell everyone.<<else>>Someone has stopped to stare at you, looking shocked and disgusted, before turning away.<</if>>
	<br><br>
	<span class="red">Your cheeks burn with embarrassment.</span> You straighten your clothes and leave as fast as you can.
	<<stress 10>><<gstress>>
	<<if _pnFK is "school">><<status -5>><<lcool>><</if>>
<<else>>
	_pnWhere and relieve yourself as quickly as you can. Nobody seems to have noticed. You feel much more comfortable, if a little ashamed.
<</if>>
<<run plusNeedsToilet("both")>>
<br><br>
<<getouticon>><<link [[Continue|$plusToiletReturn]]>><<set $eventskip to 1>><</link>>
