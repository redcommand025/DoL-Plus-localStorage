:: Widgets Plus Needs [widget plusneeds]
/* Sidebar captions for the Plus Needs mod. Values: 2000 = satisfied, 0 = empty. */
<<widget "plusneedsbar">>
	/* _args[0] = label, _args[1] = value, _args[2..5] = flavor text full/mid/low/very low */
	<<set _pnValue to Math.clamp(_args[1], 0, 2000)>>
	<div @class="'plusneedscaption' + ($options.showCaptionText is true ? '' : ' rightMeterText')" @title="_args[0] + ': ' + _pnValue.toFixed(0) + ' / 2000'">
		<div @class="($options.showCaptionText is true ? '' : 'rightMeterText')">
			_args[0]:
			<<if $options.showCaptionText is true>>
				<<if _pnValue gte 1500>>
					<span class="green">_args[2]</span>
				<<elseif _pnValue gte 1000>>
					<span class="lblue">_args[3]</span>
				<<elseif _pnValue gte 400>>
					<span class="purple">_args[4]</span>
				<<else>>
					<span class="red">_args[5]</span>
				<</if>>
			<</if>>
		</div>
		<<set _showCaptionText to !$options.showCaptionText>>
		<<statbarinverted _pnValue 2000 _showCaptionText>>
	</div>
<</widget>>

<<widget "plusneedscaption">>
	<<run plusNeedsInit()>>
	<<plusneedsbar "Hunger" $plusHunger "You feel well fed." "You could go for a snack." "You should eat something." "You're starving.">>
	<<plusneedsbar "Thirst" $plusThirst "You're not thirsty." "You could use a drink." "You should drink something." "You're parched.">>
	<<plusneedsbar "Bladder" $plusBladder "You feel comfortable." "You'll need the toilet at some point." "You should find a toilet soon." "You really need a toilet now!">>
	<<plusneedsbar "Bowels" $plusBowels "You feel comfortable." "You'll need the toilet at some point." "You should find a toilet soon." "You really need a toilet now!">>
	<<if $plusHunger lte 0 or $plusThirst lte 0>>
		<span class="red">You feel weak.</span>
	<</if>>
	<<if $plusHunger lte 0>>
		<span class="red">Your stomach aches with hunger.</span>
	<</if>>
	<<if $plusThirst lte 0>>
		<span class="red">Your head pounds from thirst.</span>
	<</if>>
<</widget>>

/* Link shown in bathrooms and toilets. */
<<widget "plusToiletLink">>
	<<bathroomicon "sink">><<link [[Use the toilet (0:03)|Plus Needs Toilet]]>><<set $plusToiletReturn to $passage>><</link>>
	<br>
<</widget>>

<<widget "plusKitchenSnack">>
	<<foodicon "creambun">><<link [[Have a quick snack and a glass of water (0:10)|Plus Needs Kitchen Snack]]>><<pass 10>><<set $plusToiletReturn to $passage>><</link>>
	<br>
<</widget>>

<<widget "plusNeedsAccident">>
	<<set _pnWhich to _args[0]>>
	<span class="pink">
	<<if _pnWhich is "plusBladder">>
		You couldn't hold it any longer and didn't make it to a toilet in time. You have wet yourself.
	<<elseif _pnWhich is "plusBowels">>
		You couldn't hold it any longer and didn't make it to a toilet in time. You have soiled yourself.
	<<else>>
		You couldn't hold it any longer and didn't make it to a toilet in time. You have had an accident at both ends.
	<</if>>
	</span>
	Your face burns with embarrassment, and your clothes will need a good wash.
	<<stress 12>><<gstress>><<set $hygiene to Math.clamp($hygiene + 400, 0, 2000)>>
	<br>You feel less in control of yourself.
	<<if _pnWhich is "plusBladder">><<control -10>><<lcontrol>><<elseif _pnWhich is "plusBowels">><<control -25>><<llcontrol>><<else>><<control -40>><<lllcontrol>><</if>>
<</widget>>

:: Plus Needs Toilet [plusneeds]
<<effects>><<pass 3>>
<<if $plusBladder lt 1900 or $plusBowels lt 1900>>
	You find a free stall and use the toilet, then wash your hands at the sink. You feel much more comfortable.
<<else>>
	You use the toilet, then wash your hands at the sink. You didn't really need to go.
<</if>>
<<run plusNeedsToilet("both")>>
<br><br>
<<bathroomicon "sink">><<link [[Drink some water from the tap (0:01)|Plus Needs Toilet Drink]]>><<pass 1>><<run plusNeedsConsume(0, 300, "drink", 250)>><</link>>
<br>
<<getouticon>><<link [[Finish|$plusToiletReturn]]>><<set $eventskip to 1>><</link>>

:: Plus Needs Toilet Drink [plusneeds]
<<effects>>
You cup your hands under the tap and drink some cold water.
<br><br>
<<getouticon>><<link [[Finish|$plusToiletReturn]]>><<set $eventskip to 1>><</link>>

:: Plus Needs Kitchen Snack [plusneeds]
<<effects>>
You grab a quick snack and a glass of water.
<<run plusNeedsConsume(450, 250, "snack", 250)>>
<br><br>
<<getouticon>><<link [[Finish|$plusToiletReturn]]>><<set $eventskip to 1>><</link>>

:: Widgets Plus Needs Mobile [widget plusneeds]
<<widget "plusNeedsMobileStat">>
	/* _args: label, name, value. Full (2000) = green, empty = red. */
	<<mobileStatsColorSetIverted `Math.clamp(_args[2], 0, 2000)` 2000>>
	<div @class="'stat plus-needs-mini ' + _mobileColor">
		<mouse class="tooltip-centertop">_args[0]<span>_args[1]: <<print Math.round(_args[2])>> / 2000</span></mouse>
	</div>
<</widget>>

<<widget "plusNeedsMobile">>
	<<if Number.isFinite($plusHunger)>><<plusNeedsMobileStat "Hu" "Hunger" $plusHunger>><</if>>
	<<if Number.isFinite($plusThirst)>><<plusNeedsMobileStat "Th" "Thirst" $plusThirst>><</if>>
	<<if Number.isFinite($plusBladder)>><<plusNeedsMobileStat "Bl" "Bladder" $plusBladder>><</if>>
	<<if Number.isFinite($plusBowels)>><<plusNeedsMobileStat "Bw" "Bowels" $plusBowels>><</if>>
<</widget>>

:: Widgets Plus Needs Statistics [widget plusneeds]
<<widget "plusNeedsStatistics">>
	<<run plusNeedsInit()>><<set _pns to plusNeedsStats()>>
	<<foldout false "_plusNeedsFoldout">>
		<span class="gold">Needs</span>
		Total drunk: <<print (_pns.mlTotal / 1000).toFixed(2)>> litres (<<print _pns.mlTotal>> ml)
		<br>
		Drunk today: <<print _pns.mlToday>> ml
		<br>
		Drinks: _pns.drinks
		<br>
		Meals eaten: _pns.meals
		<br>
		Snacks eaten: _pns.snacks
		<br>
		Food eaten: about <<print _pns.kcal.toLocaleString()>> kcal
		<br>
		Toilet trips (bladder): _pns.pees
		<br>
		Toilet trips (bowels): _pns.poops
		<br>
		Times spotted relieving yourself outdoors: <<print _pns.spotted or 0>>
		<br>
		Accidents (wet/soiled/both at once): _pns.accWet/_pns.accSoiled/_pns.accBoth
		<br>
		Times you were starving (hunger hit 0): _pns.zeroHunger
		<br>
		Times you were parched (thirst hit 0): _pns.zeroThirst
		<br><br>
	<</foldout>>
<</widget>>

:: Widgets Plus Needs Spots [widget plusneeds]
/* Public drinking spot. _args[0]: "fountain" | "stream" | "lake" | "cooler" | "cafe" | "shower" */
<<widget "plusDrinkLink">>
	<<set _pnSpot to _args[0]>>
	<<if _pnSpot is "stream">><<set _pnLabel to "Drink from the stream">><<elseif _pnSpot is "lake">><<set _pnLabel to "Drink some water from the lake">><<elseif _pnSpot is "cafe">><<set _pnLabel to "Ask for a glass of water">><<else>><<set _pnLabel to "Drink some water">><</if>>
	<<capture _pnSpot>><<bathroomicon "sink">><<link `_pnLabel + " (0:02)"` "Plus Needs Drink">><<set $plusDrinkSpot to _pnSpot>><<set $plusDrinkReturn to $passage>><</link>><</capture>>
	<br>
<</widget>>

/* Outdoor toilet. _args[0]: "forest" | "park" | "beach" | "lake" | "wolfcave" */
<<widget "plusOutdoorToiletLink">>
	<<if _args[0] is "beach">><<set _pnLabel to "Relieve yourself behind the dunes (0:03)">><<elseif _args[0] is "park">><<set _pnLabel to "Relieve yourself behind some bushes (0:03)">><<elseif _args[0] is "wolfcave">><<set _pnLabel to "Relieve yourself at the edge of the clearing (0:03)">><<else>><<set _pnLabel to "Relieve yourself behind a tree (0:03)">><</if>>
	<<set _pnOut to _args[0]>><<capture _pnOut>><<foresticon>><<link _pnLabel "Plus Needs Outdoor Toilet">><<set $plusOutdoorSpot to _pnOut>><<set $plusToiletReturn to $passage>><</link>><</capture>>
	<br>
<</widget>>

:: Plus Needs Drink [plusneeds]
<<effects>><<pass 2>>
<<set _pnSpot to $plusDrinkSpot>>
<<if _pnSpot is "stream">>
	You kneel by the stream, cup your hands in the cold, clear water and drink.
	<<run plusNeedsConsume(0, 350, "drink", plusNeedsML["stream"])>>
<<elseif _pnSpot is "lake">>
	You crouch at the water's edge and drink a few handfuls of cool lake water.
	<<run plusNeedsConsume(0, 350, "drink", plusNeedsML["lake"])>>
<<elseif _pnSpot is "cooler">>
	You fill a paper cup at the water cooler and drink it down.
	<<run plusNeedsConsume(0, 250, "drink", plusNeedsML["water cooler"])>>
<<elseif _pnSpot is "cafe">>
	You ask for a glass of tap water. It's brought over with a polite smile, and you drink it gratefully.
	<<run plusNeedsConsume(0, 300, "drink", plusNeedsML["cafe water"])>>
<<elseif _pnSpot is "shower">>
	You find the tap by the beach showers and drink some fresh water.
	<<run plusNeedsConsume(0, 250, "drink", plusNeedsML["fountain"])>>
<<else>>
	You lean over the drinking fountain and take a long drink of cool water.
	<<run plusNeedsConsume(0, 250, "drink", plusNeedsML["fountain"])>>
<</if>>
You feel refreshed.
<br><br>
<<getouticon>><<link [[Finish|$plusDrinkReturn]]>><<set $eventskip to 1>><</link>>

:: Plus Needs Outdoor Toilet [plusneeds]
<<effects>><<pass 3>>
<<set _pnChance to plusNeedsSpotChance($plusOutdoorSpot)>>
<<set _pnSpotted to random(1, 1000) lte _pnChance * 1000>>
<<if $plusOutdoorSpot is "beach">><<set _pnWhere to "behind a dune">><<elseif $plusOutdoorSpot is "park">><<set _pnWhere to "behind a clump of bushes">><<elseif $plusOutdoorSpot is "wolfcave">><<set _pnWhere to "at the edge of the clearing">><<else>><<set _pnWhere to "behind a thick tree">><</if>>
<<if _pnSpotted>>
	You find a spot _pnWhere and relieve yourself. Just as you finish, you hear footsteps. Someone walking by stops and stares at you, then quickly looks away.
	<br><br>
	<span class="red">Your cheeks burn with embarrassment.</span> You straighten your clothes and hurry off without looking back.
	<<stress 6>><<gstress>>
	<<run plusNeedsSpotted()>>
<<else>>
	You find a quiet spot _pnWhere and relieve yourself. Nobody seems to have noticed. You feel much more comfortable.
<</if>>
<<run plusNeedsToilet("both")>>
<br><br>
<<getouticon>><<link [[Continue|$plusToiletReturn]]>><<set $eventskip to 1>><</link>>

:: Widgets Plus Needs Notices [widget plusneeds]
<<widget "plusNeedsNeedNotice">>
	<<for _pnN range _plusNeedsNoticeList>>
		<<if _pnN.tier gte 3>><span class="red">_pnN.text</span>
		<<elseif _pnN.tier is 2>><span class="purple">_pnN.text</span>
		<<else>><span class="lblue">_pnN.text</span><</if>>
		<br>
	<</for>>
	<<if _plusNeedsNoticeStress>><<gstress>><</if>><<if _plusNeedsNoticePain>><<gpain>><</if>>
<</widget>>
